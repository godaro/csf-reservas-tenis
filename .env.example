# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). La clave "anon" es pública: está pensada
# para usarse en la web. NUNCA pongas acá la clave "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
